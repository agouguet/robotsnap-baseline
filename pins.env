# Every version this repository depends on, in one place.
#
# Flat key=value on purpose: lib/common.sh sources this file, so the entry point
# needs no YAML parser and no Python to answer "pins" or "doctor". When a method
# stops fitting in flat keys, that is the moment to move to YAML - not before.

# --- the application and the platform ----------------------------------------
# The RobotSNAP build the integrations were verified against. The hash is the one
# this workspace's app/ carried when DRL-VO and CoHAN-Nav2 were run end to end; a
# build you make yourself will differ, which doctor reports without failing.
ROBOTSNAP_APP_VERSION=0.1.0
ROBOTSNAP_APP_SHA256=a9a83136f9f1e9bb13e145b651e13a947bbff6d6a9281f92f0791afc397104cb
ROBOTSNAP_APP_URL=
ROBOTSNAP_CORE_TESTED=0.1.0

# --- the machine the integrations were verified on ---------------------------
UBUNTU_RELEASE=22.04
ROS_DISTRO=humble

# --- CoHAN-Nav2 (HATEB under nav2) -------------------------------------------
# A colcon workspace built on the host, so the upstream is pinned by commit and
# its two submodules by theirs.
COHAN_UPSTREAM=https://github.com/sphanit/CoHAN-Nav2.git
COHAN_COMMIT=094f095a4cb0dfb774730c6020750c72adef0773
COHAN_BEHAVIOR_TREE_COMMIT=322add842ce70bc9935f615ced6a6405353bd5e5
COHAN_COSTMAP_CONVERTER_COMMIT=9565858432664e9cfe0b3556e1809336c4ab06d4
COHAN_APT=libopenblas-dev

# --- DRL-VO ------------------------------------------------------------------
# The upstream only ever shipped ROS 1; this integration is a ROS 2 port of its
# policy, so what matters is the checkpoint, pinned by hash. The commit is the
# tree the checkpoint and the network code were read from.
DRLVO_UPSTREAM=https://github.com/TempleRAIL/drl_vo_nav.git
DRLVO_COMMIT=6a6a543
DRLVO_MODEL_SHA256=78a6bc9918b092e2bd26782664248d9ce06a5498e7cd086260dbfe6548f99645
# The image the port was checked against, kept as the oracle of the fidelity
# test. Not needed to run the integration, only to re-verify it.
DRLVO_REFERENCE_IMAGE=agouguet/benchmark-social-navigation:drl_vo

# --- the ROS 1 side, shared by every ROS 1 method ----------------------------
# A ROS 1 method cannot join the ROS 2 graph on its own: it needs a ROS 1 master
# and a bridge. tools/ros1/compose.yaml brings both up, and these two images are
# what it brings up - the same pair for CADRL and SARL*, so the two methods only
# differ by their own image and their own launch command.
#
# Caveat, measured: the bridge image ships ROS 1 Noetic and ROS 2 Foxy with the
# standard message packages, so Twist, Odometry, PoseStamped and String cross it
# and agents_msgs/AgentArray does not. That is why the crowd is converted on the
# ROS 1 side, inside the method container, by tools/ros1/robotsnap_ros1_adapter.py
# - and why a method that needs a message the bridge does not know would need the
# bridge rebuilt rather than a remap.
ROS1_MASTER_IMAGE=ros:noetic
ROS1_BRIDGE_IMAGE=my_ros1_bridge

# --- CADRL -------------------------------------------------------------------
# The published graph, run as its own authors shipped it: a ROS 1 Kinetic image
# with the pretrained checkpoint inside the package. Nothing is vendored here and
# nothing is patched - the frame and the topic names are adapted outside, in
# tools/ros1/.
CADRL_UPSTREAM=https://github.com/mit-acl/cadrl_ros.git
CADRL_COMMIT=8549a79
CADRL_IMAGE=agouguet/benchmark-social-navigation:cadrl
# The digest of the image the integration was measured against. The tag can be
# moved; this cannot.
CADRL_IMAGE_ID=sha256:f3a85f7f3acdeb8c341de6810f51f8f9c7e134532917344f53b7a7176201a072

# --- SARL* -------------------------------------------------------------------
# Same shape as CADRL: the authors' ROS 1 Kinetic image, checkpoint included.
SARL_STAR_UPSTREAM=https://github.com/LeeKeyu/sarl_star.git
SARL_STAR_COMMIT=179e314
SARL_STAR_IMAGE=agouguet/benchmark-social-navigation:sarl_star
SARL_STAR_IMAGE_ID=sha256:091d617d7ab3d691e7f852f4469913893394a4ffe5818cc888a1982ec772a045

# --- MPC + EBM ---------------------------------------------------------------
# The optimal-control end of the comparison: a receding-horizon solver, no
# learned policy. The image carries neither .git nor a provenance label, so what
# can be pinned is the image itself, by digest - the tag can be moved, the
# digest cannot. The build source was the benchmark's own compose file.
MPC_EBM_IMAGE=agouguet/benchmark-social-navigation:mpc_ebm
MPC_EBM_IMAGE_ID=sha256:208a47e6f4da985b71c48ce9a503a8ec1e8f72583947ae11e2a478ff0d37d1b1
MPC_EBM_SCENES=corner,crowd,frontal,intersection,narrow_passage,perpendicular_traffic
# Measured, not assumed: the EBM prediction head calls sys.exit(0) when
# torch.cuda.is_available() is false. Without a GPU the MPC still plans and
# publishes /cmd_vel; only the learned crowd prediction is absent.
MPC_EBM_GPU="the EBM head needs CUDA; the MPC alone does not"
