# What this method is and what it needs, in one place.
#
# robotsnap-baseline reads MODE, ROS and SUMMARY to list it; install.sh,
# check.sh and run.sh read the rest. Keeping them here is what lets the three
# scripts agree without repeating a path in three files.
#
# The file is *sourced* by a shell, so every value is quoted: a value with a
# space or a bracket is not an assignment otherwise.

# ros1-image: the authors' own ROS 1 image, behind a ROS 1 <-> ROS 2 bridge.
# The master, the bridge and the ROS 1 view of RobotSNAP are not written here:
# lib/common.sh composes tools/ros1/compose.yaml from these three values.
MODE="ros1-image"
ROS="kinetic"
SUMMARY="CADRL (pretrained value network, ROS 1)"

# The image install.sh expects. install.sh checks it, check.sh inspects it, and
# its name comes from pins.env (CADRL_IMAGE) so the two never drift.
IMAGE="agouguet/benchmark-social-navigation:cadrl"

# The ROS 1 environment the method container sources, and the launch that starts
# the node. Both are exactly what the image documents - nothing is patched.
#
# The launch is spelled `stdbuf -o L` because that is how the image starts it
# too: without it the node's Python stdout is block-buffered, and the tmux
# `method` window stays empty while the node is already running.
METHOD_ROS_ENV="source /opt/ros/kinetic/setup.bash && source /root/cadrl_ws/devel/setup.bash"
METHOD_LAUNCH="stdbuf -o L roslaunch cadrl_ros cadrl_node.launch"

# Echoed in the goal window. CADRL reads /global_goal (PoseStamped); the goal is
# sent in ROS 2 and ros1_bridge carries it across to the ROS 1 node.
GOAL_HINT="python tools/send_goal.py X Y [YAW_DEG]   ->  /global_goal (frame map)"
GOAL_INTERFACE="topic"
GOAL_TOPIC="/global_goal"
