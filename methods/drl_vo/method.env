# What this method is and what it needs, in one place.
#
# DRL-VO is a ROS 2 port of the published ROS 1 policy: its nodes are Python
# files in this directory, the checkpoint is under model/, and there is nothing
# to build. install.sh only checks that the checkpoint and the interpreter are
# the ones the port was verified against.
#
# The file is *sourced* by a shell, so every value is quoted.

MODE="host-ros2"
ROS="humble"
SUMMARY="DRL-VO (ROS2 port of the T-RO 2023 policy)"

# No colcon workspace: the port is plain Python nodes on the RobotSNAP bridge.
WORKSPACE=""

# No extra setups beyond ROS and the Python package.
SOURCES=""

# Echoed in the goal window.
GOAL_HINT="python send_goal.py X Y [YAW_DEG] --robot robot_1  (map frame, metres)"

# No goal pane: the observation builder reads the scenario's goal straight out of
# /simulation/state, so the robot already drives off when the episode starts and
# there is nothing for a second sender to add.
GOAL_INTERFACE=""
