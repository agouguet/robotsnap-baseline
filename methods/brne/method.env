# What this method is and what it needs, in one place.
#
# BRNE ships as a Docker image built by its own authors for this benchmark: the
# upstream code is not vendored here and is not modified. The two things it
# cannot know - RobotSNAP's topic names and its frames - are adapted outside the
# container, by tools/agents_adapter.py and tools/odom_relay.py.

MODE="ros2-image"
ROS="humble"
SUMMARY="BRNE (pretrained RL, upstream image)"

# The image install.sh expects, and the name its container takes. The name is
# ours so two sessions cannot collide and --stop knows what to kill.
IMAGE="agouguet/benchmark-social-navigation:brne"
CONTAINER="robotsnap_brne"

# agents_msgs lives in the legacy ROS2 workspace, and both the adapter and the
# container speak it. Sourced after ROS, before anything else.
SOURCES="tmux/ros2_ws/install/setup.bash"

# Echoed in the goal window.
GOAL_HINT="python tools/send_goal.py X Y [YAW_DEG]   ->  /global_goal (frame map)"
GOAL_INTERFACE="topic"
GOAL_TOPIC="/global_goal"
