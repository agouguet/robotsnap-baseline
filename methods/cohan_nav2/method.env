# What this method is and what it needs, in one place.
#
# bin/robotsnap-baseline reads MODE, ROS and SUMMARY to list it; install.sh,
# check.sh and run.sh read the rest. Keeping them here is what lets the three
# scripts agree without repeating a path in three files.
#
# The file is *sourced* by a shell, so every value is quoted: a value with a
# space or a bracket is not an assignment otherwise.

# host-ros2: built on the host as a colcon workspace, no container.
MODE="host-ros2"
ROS="humble"
SUMMARY="CoHAN-Nav2 (HATEB under nav2)"

# The colcon workspace install.sh prepares, relative to this repository. It is
# built under work/, which git ignores: the repository carries sources and pins,
# never build output.
WORKSPACE="work/cohan_nav2_ws"

# Setup files sourced after ROS and before the Python package, relative to the
# workspace above this repository. The legacy ROS2 endpoint workspace is listed
# because the verified run sourced it; when it is absent the launch warns and
# carries on, since none of CoHAN's own nodes read anything from it.
SOURCES="tmux/ros2_ws/install/setup.bash"

# Packages apt must have. libopenblas is what the HATEB planner plugin links
# against; without it controller_server cannot load the plugin.
APT="libopenblas-dev"

# Echoed in the goal window, so the spelling of the goal command is never a
# guess.
GOAL_HINT="python send_goal.py X Y [YAW_DEG]  ->  navigate_to_pose action, frame map"
