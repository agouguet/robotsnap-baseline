# What this method is and what it needs, in one place.
#
# robotsnap-baseline reads MODE, ROS and SUMMARY to list it; install.sh,
# check.sh and run.sh read the rest. Keeping them here is what lets the three
# scripts agree without repeating a path in three files.
#
# The file is *sourced* by a shell, so every value is quoted: a value with a
# space or a bracket is not an assignment otherwise.

# ros1-image: the authors' own ROS 1 image, behind a ROS 1 <-> ROS 2 bridge.
# The master, the bridge and the ROS 1 view of RobotSNAP are not written here:
# lib/common.sh composes tools/ros1/compose.yaml from these three values.
MODE="ros1-image"
ROS="kinetic"
SUMMARY="SARL* (pretrained social attention, ROS 1)"

# The image install.sh expects. install.sh checks it, check.sh inspects it, and
# its name comes from pins.env (SARL_STAR_IMAGE) so the two never drift.
IMAGE="agouguet/benchmark-social-navigation:sarl_star"

# The ROS 1 environment the method container sources.
METHOD_ROS_ENV="source /opt/ros/kinetic/setup.bash && source /root/sarl_ws/devel/setup.bash"

# The minimal launch, not navigation.launch.
#
# navigation.launch is too big for RobotSNAP: on top of the planner and of
# agents_to_people.py it includes turtlebot_navigation's hokuyo_move_base, which
# brings map_server, the two costmaps, move_base, the velocity smoother, the
# safety controller and a laser - none of which RobotSNAP has, and none of which
# the network needs to *plan*. sarl_star_node.py plans its own velocity
# (policy.predict -> /cmd_vel); it does not ask move_base for a path.
#
# The network also reads two topics that the turtlebot include used to publish
# and that RobotSNAP does not: /amcl_pose (it takes its own pose from there, not
# from /robot_odom) and /move_base/global_costmap/costmap (policy.with_costmap is
# hardcoded True). The shared ROS 1 view, tools/ros1/robotsnap_ros1_adapter.py,
# publishes both from /odom and /map, plus the map -> odom -> base_link
# transform the node waits on - so the gate below does open, measured.
#
# What is reproduced here are navigation.launch's own three remaps, as rosrun
# arguments, so no upstream file is touched:
#   <remap from="odom" to="robot_odom"/>
#   <remap from="local_goal" to="global_goal"/>
#   <remap from="cmd_vel_mux/input/teleop" to="cmd_vel"/>
# agents_to_people.py is navigation.launch's other node, kept because nothing
# else turns /social_sim/agents into the /people the network reads.
#
# The two nodes run under one `bash -c` on purpose. compose prefixes the launch
# with `exec `, and `A & exec B` would leave B outside the ROS environment that
# METHOD_ROS_ENV exports: the `&` ends the list, so only A inherits the sources.
# One inner shell keeps both nodes on the same sourced environment, and its own
# `exec` still makes the node PID 1 of the container's command.
METHOD_LAUNCH="bash -c 'rosrun sarl_star_ros agents_to_people.py agents:=social_sim/agents & exec rosrun sarl_star_ros sarl_star_node.py odom:=robot_odom local_goal:=global_goal cmd_vel_mux/input/teleop:=cmd_vel'"

# Echoed in the goal window. SARL* reads /global_goal (PoseStamped); the goal is
# sent in ROS 2 and ros1_bridge carries it across to the ROS 1 node.
GOAL_HINT="python tools/send_goal.py X Y [YAW_DEG]   ->  /global_goal (frame map)"
GOAL_INTERFACE="topic"
GOAL_TOPIC="/global_goal"
