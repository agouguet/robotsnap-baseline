# What this method is and what it needs, in one place.
#
# mpc_ebm is the optimal-control end of the comparison: no learning, no
# pretrained value network. Its authors shipped it as a ROS 2 Humble image
# built for this benchmark, and the image is used as it is - nothing inside is
# patched. The three things it cannot know - RobotSNAP's odometry name, the
# crowd message and the scene it plans in - are adapted beside it by
# tools/odom_relay.py, tools/agents_adapter.py and run.sh.

MODE="ros2-image"
ROS="humble"
SUMMARY="MPC + EBM (optimal control, upstream image)"

# The image install.sh expects, and the name its container takes. The name is
# ours so two sessions cannot collide and --stop knows what to kill.
IMAGE="agouguet/benchmark-social-navigation:mpc_ebm"
CONTAINER="robotsnap_mpc_ebm"

# simulation_msgs carries the scene_info the image's map nodes read, and
# agents_msgs is what the crowd adapter speaks. Both live in the legacy ROS 2
# workspace; it is sourced after ROS and before anything else.
SOURCES="tmux/ros2_ws/install/setup.bash"

# The benchmark maps the image ships, and the one used unless --scene says
# otherwise. The MPC plans in that map's coordinates, so the name has to match
# the scenario RobotSNAP is playing, not just label it.
SCENES="corner crowd frontal intersection narrow_passage perpendicular_traffic"
DEFAULT_SCENE="crowd"

# Echoed in the goal window. There is no goal topic: the method follows the
# path its schedule file describes, and the goal is that path's last node.
GOAL_HINT="no goal topic: edit assets/maps/<scene>/schedule.csv inside the image, or relaunch with another --scene"

# No goal pane: the image schedules its own agents and reads no goal topic, so
# there is no interface to hand the scenario's goal to.
GOAL_INTERFACE=""
