# What this method is and what it needs, in one place.
#
# The reference point of the benchmark, and the only method that is not a
# learned policy: the DWB local planner of nav2, driven by its own global
# planner. It has no model of people at all - which is exactly what makes it
# worth measuring against: it says what a competent classical navigator does
# when it treats a crowd as moving obstacles it cannot see.

MODE="host-ros2"
ROS="humble"
SUMMARY="nav2 + DWB (classical, no learning)"

# nav2 ships the launch and the plugins; nothing is built here.
WORKSPACE=""
SOURCES=""

# Echoed in the goal window. nav2 takes goals as an action, not a topic.
GOAL_HINT="python tools/send_goal_nav2.py X Y [YAW_DEG]  ->  navigate_to_pose action, frame map"

# How the method wants to be told the scenario's goal, and where. The goal pane
# of the goal window calls tools/scenario_goal.py with these; a method that reads
# /simulation/state itself leaves GOAL_INTERFACE empty and gets no pane, because
# there would be nothing for it to say.
GOAL_INTERFACE="action"
